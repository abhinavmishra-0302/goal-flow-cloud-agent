# --- LLM via OpenRouter (LLM-only; required for goal interpretation) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Any OpenRouter model id.
OPENROUTER_MODEL=openai/gpt-oss-120b
# Cap per-request token reservation (avoids HTTP 402 on low-credit keys). Default 2500.
OPENROUTER_MAX_TOKENS=2500

# --- WebSocket hub server ---
WS_HOST=0.0.0.0
WS_PORT=8000

# --- Structured logging (leveled, correlation-id tagged) ---
LOG_LEVEL=INFO
