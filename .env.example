# --- LLM via OpenRouter (LLM-only; required for goal interpretation) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Any OpenRouter model id.
OPENROUTER_MODEL=openai/gpt-oss-120b
# Cap per-request token reservation (avoids HTTP 402 on low-credit keys). Default 2500.
OPENROUTER_MAX_TOKENS=2500

# --- WebSocket hub server ---
WS_HOST=0.0.0.0
WS_PORT=8000

# --- Structured logging (leveled, correlation-id tagged) ---
LOG_LEVEL=INFO

# v6 — where the household constraint store lives. Unset = the repo's seed
# (data/memory/family_profile.json). Capture WRITES to this file, so point it at a
# scratch copy for a demo and the seed stays pristine; a path that does not exist yet
# is seeded from the repo's copy on first use. This is the cloud's `--data`.
# GOALFLOW_PROFILE_PATH=./data/memory/demo_profile.json

# --- v8: OpenRouter PROVIDER ROUTING. The single biggest latency lever there is. ---
#
# Unset, OpenRouter load-balances this model across nineteen endpoints whose throughput
# spans 39x, and it kept landing on the slow ones. Measured, same input, same afternoon:
# four unpinned runs took 59s / 175s / 145s / 189s. Pinned to Cerebras: 8.4s / 8.4s /
# 8.7s / 10.1s. Same task benchmarked alone — 50.1s unpinned (CoreWeave, 52 tok/s) vs
# 1.5s (Cerebras, 1523 tok/s).
#
# allow_fallbacks defaults TRUE: a busy Cerebras should cost you Groq (still ~9x better
# than unpinned), not the demo.
OPENROUTER_PROVIDER_ORDER=cerebras,groq
# OPENROUTER_PROVIDER_ALLOW_FALLBACKS=true

# --- v8: reasoning_effort. BUILT AND DELIBERATELY LEFT OFF. ---
# DO NOT SET THIS TO "low" WITHOUT RE-MEASURING — benchmarked on every provider, reasoning
# tokens collapse from ~1400 to 26-89 and the call stops working. Values: minimal | low |
# medium | high. Unset = the field is never sent.
# OPENROUTER_REASONING_EFFORT=medium
